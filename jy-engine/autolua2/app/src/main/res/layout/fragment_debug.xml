<?xml version="1.0" encoding="utf-8"?>
<!-- 远程调试面板（9.11 调试通道整合：8176 老通道退役，统一 8080 WebSocket IDE） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ui.debug.DebugFragment"
    android:background="#D3D3D3">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:stretchColumns="1">

            <TableRow
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:id="@+id/title_remote_debug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_span="2"
                    android:padding="4dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/remote_debug_title" />
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/ide_state" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_ide_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ide_state_stopped" />
                    <TextView
                        android:id="@+id/tv_ide_port"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/ide_port_not_started" />
                </LinearLayout>
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/ide_clients" />
                <TextView
                    android:id="@+id/tv_client_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="0" />
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/my_ip" />
                <TextView
                    android:id="@+id/my_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/null_ip"/>
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/udp_discovery" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_udp_discovery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    android:checked="true"/>
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/screen_stream_switch" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_screen_stream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:checked="false"/>
                    <TextView
                        android:id="@+id/tv_stream_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/stream_state_off" />
                </LinearLayout>
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:id="@+id/tv_connect_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_span="2"
                    android:padding="4dp"
                    android:text="@string/ide_connect_hint_off" />
            </TableRow>

            <!-- ===== 权限引导（免 root 能力：投屏虚拟屏 / 无障碍注入 / Shizuku） ===== -->
            <TableRow
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:id="@+id/title_permissions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_span="2"
                    android:padding="4dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/perm_title" />
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border"
                android:id="@+id/row_perm_projection">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/perm_projection" />
                <TextView
                    android:id="@+id/tv_perm_projection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingEnd="10dp" />
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border"
                android:id="@+id/row_perm_accessibility">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/perm_accessibility" />
                <TextView
                    android:id="@+id/tv_perm_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingEnd="10dp" />
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border"
                android:id="@+id/row_perm_shizuku">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/perm_shizuku" />
                <TextView
                    android:id="@+id/tv_perm_shizuku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingEnd="10dp" />
            </TableRow>

            <TableRow
                android:minHeight="45dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border"
                android:id="@+id/row_inject_mode">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/inject_mode" />
                <TextView
                    android:id="@+id/tv_inject_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingEnd="10dp" />
            </TableRow>

            <TableRow
                android:layout_marginBottom="8dp"
                android:background="@drawable/table_row_border">
                <TextView
                    android:id="@+id/tv_perm_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_span="2"
                    android:padding="4dp"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:text="@string/perm_hint" />
            </TableRow>

        </TableLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
