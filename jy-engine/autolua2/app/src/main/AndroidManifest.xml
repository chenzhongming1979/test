<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="com.autolua.autolua2.MainService"
        android:description="@string/main_service_permission"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 进程保活体系追加权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 脚本日志落盘（ScriptLogPersister）：/sdcard/Pictures 写入需"所有文件访问"授权；
         未授权时自动回退应用专属目录（/sdcard/Android/data/<pkg>/files/logs，免权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Shizuku api/provider 13.1.5 分别声明 minSdk 24/23，本应用 minSdk 22，强制合并（Shizuku 注入通道在 API 22 上不可用，其余功能不受影响） -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api,rikka.shizuku.provider,rikka.shizuku.shared,rikka.shizuku.aidl" />

    <!-- 无障碍守护厂商引导（P1.5）：Android 11+ 包可见性声明，
         否则 resolveActivity 对厂商安全中心页面返回 null，矩阵无法命中 -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.meizu.safe" />
    </queries>
    <application
        android:name=".MainApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autolua2"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!-- 9.11 调试通道整合：老 8176 调试服务 .debug.DebugServiceImp 已摘除
             （代码文件保留，需要对接 MLN Kit 时可一键恢复）；统一走 IdeServerManager(8080 WS) -->
        <service
            android:name=".MainService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="com.autolua.autolua2.engine.AutoLuaEngineServiceImp"
            tools:ignore="ForegroundServicePermission" />

        <activity
            android:name=".activity.MainActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask" />

        <meta-data
            android:name="com.autolua.autolua2.mln.provider.GlideConfiguration"
            android:value="GlideModule" />

        <activity
            android:name="com.immomo.mls.activity.LuaViewActivity"
            tools:ignore="WrongManifestParent" />
        <activity
            android:name=".activity.SplashActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.DebugActivity"
            android:launchMode="singleTask"
            android:exported="false" />
        <activity
            android:name=".activity.ProjectActivity"
            android:launchMode="singleTask"
            android:exported="false" />
    </application>

</manifest>